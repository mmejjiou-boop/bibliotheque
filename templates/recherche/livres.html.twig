{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
    <h1>{{ titre }}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>ISBN</th>
                <th>Genre</th>
                <th>Date de publication</th>
                <th>Disponible</th>
            </tr>
        </thead>
        <tbody>
        {% for livre in livres %}
            <tr>
                <td><a href="{{ path('app_livre_show', {'id': livre.id}) }}">{{ livre.titre }}</a></td>
                <td>{{ livre.isbn }}</td>
                <td>{{ livre.genre.nom }}</td>
                <td>{{ livre.datePublication ? livre.datePublication|date('d/m/Y') : '' }}</td>
                <td>{{ livre.disponible ? 'Oui' : 'Non' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun livre trouvé</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_recherche_index') }}">Retour aux recherches</a>
{% endblock %}
